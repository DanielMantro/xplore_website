---
import StoreBadges from './StoreBadges.astro';
import XCard from './XCard.astro';
---
<section id="download" class="band-section">
  <div class="wrap">
    <div class="band">
      <div class="copy">
        <h2 class="h2">Start collecting the world.</h2>
        <p>Free on iPhone and Android. No sign-up needed: your first card is one swipe away.</p>
        <StoreBadges />
      </div>
      <div class="fan hide-m">
        <XCard name="Fiji" image="/assets/cards/fiji.webp" type="country" rarity="Rare" style="left: 0; top: 40px; width: 180px; transform: rotate(-12deg);" />
        <XCard name="Machu Picchu" image="/assets/cards/machu-picchu.webp" type="landmark" rarity="Uncommon" style="left: 120px; top: 6px; width: 180px; transform: rotate(-3deg);" />
        <XCard name="Polar Bear" image="/assets/cards/polar-bear.webp" type="wildlife" rarity="Epic" style="left: 240px; top: 30px; width: 190px; transform: rotate(9deg);" />
      </div>
    </div>
  </div>
</section>

<style>
  .band-section { padding: 96px 0; }
  .band { position: relative; overflow: hidden; border-radius: 32px; background: var(--xp-grad-ocean); padding: 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .copy { flex: 1 1 360px; display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 1; }
  .copy h2 { color: #fff; }
  .copy p { font-size: 19px; line-height: 1.55; color: rgba(255,255,255,.88); max-width: 460px; }
  .fan { flex: 0 0 auto; position: relative; width: 440px; height: 320px; }
  .fan :global(.xcard) { position: absolute; }
  @media (max-width: 640px) {
    .band-section { padding: 64px 0; }
    .band { padding: 40px 24px; border-radius: 24px; }
  }
</style>
