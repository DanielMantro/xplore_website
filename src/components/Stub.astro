---
// Temporary page body until the page is built from the brief's 03-content copy.
interface Props {
  heading: string;
  source: string;
}
const { heading, source } = Astro.props;
---
<section class="section mapbg" style="background-image: url(/assets/images/world-map.jpg);">
  <div class="wrap" style="display: flex; flex-direction: column; gap: 18px; max-width: 760px;">
    <span class="eyebrow">In progress</span>
    <h1 class="h1">{heading}</h1>
    <p class="lead">This page is being built. Content source: <code>{source}</code>.</p>
  </div>
</section>
