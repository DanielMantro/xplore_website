---
// Schematic route map (brief: 02-design-system.md › Route map): numbered pins joined by a dashed teal line,
// each pin with a card thumbnail on hover or focus. Built from stops[].lat/lng; no map tiles are loaded.
import type { Route } from '../lib/routes';
import { nightsLabel } from '../lib/routes';
import { MAP_WIDTH, projectStops, routeLengthKm } from '../lib/route-map';

interface Props {
  stops: Route['data']['stops'];
}
const { stops } = Astro.props;
const { height, points } = projectStops(stops);
const km = Math.round(routeLengthKm(stops) / 10) * 10;
const pinColor = { Common: 'var(--xp-tint)', Uncommon: 'var(--xp-tint)', Rare: 'var(--xp-rare)', Epic: 'var(--xp-epic)' } as const;
---
<figure class="route-map">
  <div class="canvas" style={`aspect-ratio: ${MAP_WIDTH} / ${height};`}>
    <svg viewBox={`0 0 ${MAP_WIDTH} ${height}`} aria-hidden="true">
      <defs>
        <pattern id="map-dots" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.4" fill="rgba(148,163,184,.14)" /></pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#map-dots)" />
      <polyline points={points.map((p) => `${p.x},${p.y}`).join(' ')} fill="none" stroke="var(--xp-tint)" stroke-width="3" stroke-dasharray="9 8" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
    {stops.map((stop, i) => (
      <button
        type="button"
        class="pin"
        style={`left: ${(points[i].x / MAP_WIDTH) * 100}%; top: ${(points[i].y / height) * 100}%; --pin: ${pinColor[stop.rarity]};`}
        aria-label={`${i + 1}. ${stop.name}, ${nightsLabel(stop.nights).toLowerCase()}, ${stop.rarity} card`}
        aria-describedby={`pin-tip-${i}`}
        data-side={points[i].x > MAP_WIDTH * 0.7 ? 'left' : 'right'}
      >
        <span aria-hidden="true">{i + 1}</span>
        <span class="tip" id={`pin-tip-${i}`} role="tooltip">
          <img src={stop.image} alt="" width="56" height="75" decoding="async" />
          <span><strong>{stop.name}</strong><span>{nightsLabel(stop.nights)} · {stop.rarity}</span></span>
        </span>
      </button>
    ))}
    <span class="tag caption">Schematic map · about {km.toLocaleString('en-GB')} km between stops</span>
  </div>
  <figcaption>
    <ol class="legend">
      {stops.map((stop, i) => (
        <li><a href={`#stop-${i + 1}`}><span class="n" style={`--pin: ${pinColor[stop.rarity]};`}>{i + 1}</span>{stop.name}<span class="nights">{nightsLabel(stop.nights)}</span></a></li>
      ))}
    </ol>
  </figcaption>
</figure>

<style>
  .route-map { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .canvas { position: relative; border-radius: 20px; border: 1px solid var(--xp-border); background: radial-gradient(circle at 70% 30%, rgba(20,184,166,.10), transparent 60%), #161B2B; }
  .canvas svg { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: inherit; }
  .caption { position: absolute; left: 16px; bottom: 16px; }

  .pin { position: absolute; z-index: 1; width: 30px; height: 30px; margin: -15px 0 0 -15px; padding: 0; border: 0; border-radius: 50%; background: var(--pin); color: #0F1117; font: 700 14px/30px var(--xp-font); text-align: center; cursor: pointer; box-shadow: 0 0 0 4px color-mix(in srgb, var(--pin) 28%, transparent); }
  .pin:hover, .pin:focus-visible { z-index: 3; outline: 2px solid #fff; outline-offset: 2px; }
  .tip { position: absolute; top: 50%; left: calc(100% + 12px); translate: 0 -50%; display: none; align-items: center; gap: 10px; padding: 8px 12px 8px 8px; width: max-content; max-width: 240px; background: var(--xp-surface-elevated); border: 1px solid var(--xp-border); border-radius: 12px; box-shadow: var(--xp-shadow-xl); color: var(--xp-text); text-align: left; font-weight: 400; line-height: 1.3; }
  .pin[data-side='left'] .tip { left: auto; right: calc(100% + 12px); }
  .pin:hover .tip, .pin:focus-visible .tip { display: flex; }
  .tip img { width: 42px; height: 56px; object-fit: cover; border-radius: 6px; flex: none; }
  .tip strong { display: block; font-size: 14px; }
  .tip span span { font-size: 12px; color: var(--xp-text-secondary); }

  .legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
  .legend a { display: inline-flex; align-items: center; gap: 8px; color: var(--xp-text); }
  .legend a:hover { color: var(--xp-tint); }
  .legend .n { width: 22px; height: 22px; border-radius: 50%; background: var(--pin); color: #0F1117; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .legend .nights { color: var(--xp-text-muted); }

  /* Pins are placed in % of a fixed aspect ratio, so phones keep the shape and the caption moves below. */
  @media (max-width: 640px) {
    .pin { width: 26px; height: 26px; margin: -13px 0 0 -13px; font-size: 12px; line-height: 26px; }
    .caption { left: 0; bottom: -38px; }
    .route-map { gap: 52px; }
  }
</style>
