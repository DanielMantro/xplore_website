---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RouteCard from '../../components/RouteCard.astro';
import DownloadBand from '../../components/DownloadBand.astro';
import { INSTAGRAM_HANDLE, INSTAGRAM_URL } from '../../consts';
import { ACTIVITY_LABELS, DURATIONS, IN_APP_LABELS, REGIONS, durationBucket, sortByDate } from '../../lib/routes';

// Copy: the brief's 03-content/blog-index.md.
const routes = sortByDate(await getCollection('routes'));

// Single choice per group; "All" clears the group. Regions without routes stay, so the empty state can invite suggestions.
const FILTERS = [
  { key: 'region', label: 'Region', options: REGIONS.filter((r) => r !== 'Middle East').map((r) => ({ value: r, label: r })) },
  { key: 'activity', label: 'Activity', options: Object.entries(ACTIVITY_LABELS).map(([value, label]) => ({ value, label })) },
  { key: 'duration', label: 'Duration', options: DURATIONS.map((d) => ({ value: d.key, label: d.key === 'weekend' ? 'Weekend (≤3 days)' : d.label })) },
  { key: 'inapp', label: 'In the app', options: [{ value: 'available', label: 'Available' }, { value: 'coming-soon', label: 'Coming soon' }] },
];

const STEPS = [
  { title: 'Read the route', text: 'Every stop with nights, tips and the best time to go.', icon: '<path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M8 7h6M8 11h6"/>' },
  { title: 'Collect the cards', text: "Each stop is a card in Xplore. Claim it when you're there.", icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="m9 12 2 2 4-4"/>' },
  { title: 'Load it into your planner', text: 'Routes are coming to the app, so you can copy them into your own trip with one tap.', icon: '<path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/>' },
];

const heroFan = routes.slice(0, 3);
---
<Base
  title="Xplore Routes — travel routes you can take into the app"
  description="Hand-picked travel routes with stops, nights and the best time to go — from Japan's classic route to Iceland's Golden Circle. Soon available straight in the Xplore trip planner."
>
  <section class="section mapbg hero" style="background-image: url(/assets/images/world-map.jpg);">
    <div class="wrap g2">
      <div class="head">
        <span class="eyebrow">Travel routes</span>
        <h1 class="h1">Routes <span class="teal">worth collecting</span></h1>
        <p class="lead">Hand-picked itineraries with every stop, how many nights to stay and the best months to go. Each route is built from Xplore cards — so you collect it as you travel.</p>
      </div>
      {/* A strip of the route hero photos, slightly fanned (brief: blog-index.md › Hero). */}
      <div class="fan hide-m" aria-hidden="true">
        {heroFan.map((r) => <img src={r.data.heroImage} alt="" width="220" height="300" />)}
      </div>
    </div>
  </section>

  <section class="list">
    <div class="wrap">
      <div class="filters" hidden>
        {FILTERS.map((group) => (
          <div class="group" role="group" aria-label={group.label} data-filter={group.key}>
            <span class="micro">{group.label}</span>
            <div class="chips">
              <button type="button" class="chip on" aria-pressed="true" data-value="">All</button>
              {group.options.map((o) => <button type="button" class="chip" aria-pressed="false" data-value={o.value}>{o.label}</button>)}
            </div>
          </div>
        ))}
        <p class="count small muted" aria-live="polite"></p>
      </div>

      <div class="g2 grid">
        {routes.map((r) => (
          <div class="item" data-region={r.data.region} data-activity={r.data.activities.join(' ')} data-duration={durationBucket(r.data.durationDays)} data-inapp={r.data.inApp || 'no'}>
            <RouteCard route={r} />
          </div>
        ))}
      </div>
      <div class="empty panel" hidden>
        <p class="h3">No route here yet</p>
        <p class="muted">Suggest one on Instagram: <a href={INSTAGRAM_URL}>@{INSTAGRAM_HANDLE}</a></p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap stack">
      <div class="head">
        <span class="eyebrow">How routes work with Xplore</span>
        <h2 class="h2">From article <span class="teal">to itinerary</span></h2>
      </div>
      <ol class="g3 steps">
        {STEPS.map((step, i) => (
          <li class="panel step">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={step.icon} /></span>
            <span class="eyebrow"><span class="num">{i + 1}</span>{step.title}</span>
            <p class="muted small">{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="small muted">Each route shows whether it's <span class="tag app">{IN_APP_LABELS['coming-soon']}</span> or already <span class="tag solid">{IN_APP_LABELS.available}</span>.</p>
    </div>
  </section>

  <section class="cta-section">
    <div class="wrap">
      <div class="panel cta">
        <div class="head" style="gap: 8px;">
          <h2 class="h3" style="font-size: 26px;">Got a route we should add?</h2>
          <p class="muted">Tell us on Instagram or through the feedback form in the app (Profile › Support us).</p>
        </div>
        <a class="btn btn-secondary" href={INSTAGRAM_URL}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>@{INSTAGRAM_HANDLE}</a>
      </div>
    </div>
  </section>

  <DownloadBand />
</Base>

<script>
  // Client-side filters over the cards' data attributes. Without JavaScript the chips stay hidden and every route shows.
  const filters = document.querySelector<HTMLElement>('.filters')!;
  const items = [...document.querySelectorAll<HTMLElement>('.list .item')];
  const empty = document.querySelector<HTMLElement>('.list .empty')!;
  const count = filters.querySelector<HTMLElement>('.count')!;
  const state: Record<string, string> = {};

  const matches = (item: HTMLElement) =>
    Object.entries(state).every(([key, value]) => !value || (item.dataset[key] ?? '').split(' ').includes(value));

  const apply = () => {
    let shown = 0;
    for (const item of items) {
      item.hidden = !matches(item);
      if (!item.hidden) shown++;
    }
    empty.hidden = shown > 0;
    count.textContent = `${shown} ${shown === 1 ? 'route' : 'routes'}`;
  };

  filters.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('button.chip');
    if (!chip) return;
    const group = chip.closest<HTMLElement>('[data-filter]')!;
    state[group.dataset.filter!] = chip.dataset.value!;
    for (const other of group.querySelectorAll<HTMLButtonElement>('button.chip')) {
      const on = other === chip;
      other.classList.toggle('on', on);
      other.setAttribute('aria-pressed', String(on));
    }
    apply();
  });

  filters.hidden = false;
  apply();
</script>

<style>
  .hero { padding-bottom: 72px; }
  .hero .g2 { align-items: center; }
  .head { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .fan { position: relative; height: 340px; }
  .fan img { position: absolute; left: 50%; top: 10px; width: 200px; height: 290px; object-fit: cover; border-radius: 18px; border: 1px solid rgba(255,255,255,.14); box-shadow: 0 24px 50px rgba(0,0,0,.5); }
  .fan img:nth-child(1) { translate: calc(-50% - 150px) 18px; rotate: -8deg; }
  .fan img:nth-child(2) { translate: -50% 0; z-index: 1; }
  .fan img:nth-child(3) { translate: calc(-50% + 150px) 18px; rotate: 8deg; }

  .list { padding: 48px 0 96px; }
  .filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 32px; margin-bottom: 32px; }
  .filters[hidden] { display: none; }
  .group { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { cursor: pointer; font-family: inherit; }
  .chip:hover { border-color: rgba(241,245,249,.3); }
  .chip:focus-visible { outline: 2px solid var(--xp-tint); outline-offset: 2px; }
  .count { grid-column: 1 / -1; margin: 0; }
  .grid { gap: 24px; }
  .item[hidden] { display: none; }
  .empty { padding: 32px; display: flex; flex-direction: column; gap: 6px; }
  .empty[hidden] { display: none; }

  .stack { display: flex; flex-direction: column; gap: 40px; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .step { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .tag { vertical-align: middle; }
  .tag.solid { background: var(--xp-tint); border-color: var(--xp-tint); color: #0F1117; }

  .cta-section { padding: 72px 0 0; }
  .cta { padding: 36px 40px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }

  @media (max-width: 900px) {
    .filters { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    /* One swipeable row per filter group. */
    .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 -16px; padding: 0 16px 4px; scrollbar-width: none; }
    .step { padding: 20px; }
    .cta { padding: 24px; }
  }
</style>
