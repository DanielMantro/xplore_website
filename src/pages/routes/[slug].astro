---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import XCard from '../../components/XCard.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import RouteCard from '../../components/RouteCard.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import DownloadBand from '../../components/DownloadBand.astro';
import RouteMap from '../../components/RouteMap.astro';
import { ACTIVITY_LABELS, IN_APP_LABELS, monthRanges, sortByDate, type Route } from '../../lib/routes';
import { splitRouteBody } from '../../lib/route-body';
import { FOUNDER_ID, ORG_ID, breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const routes = await getCollection('routes');
  return routes.map((route) => ({ params: { slug: route.data.slug }, props: { route, all: routes } }));
}

const { route, all } = Astro.props as { route: Route; all: Route[] };
const { data } = route;
// Rendered body, split so each stop's card sits beside its "###" section.
const segments = splitRouteBody(route.rendered?.html ?? '');
const related = sortByDate(all.filter((r) => r.id !== route.id)).slice(0, 2);
const published = data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const url = new URL(`/routes/${data.slug}`, Astro.site).href;
const countries = data.countries.map((code) => new Intl.DisplayNames(['en'], { type: 'region' }).of(code)!);
const stopNames = data.stops.map((s) => s.name);
// One quotable sentence with the route's key facts, for readers and AI answer engines alike.
const inShort = `${data.durationDays} days and ${data.nights} nights in ${countries.join(' and ')}, with ${data.stops.length} stops: ${stopNames.join(' → ')}. Best time to go: ${monthRanges(data.bestMonths, 'long')}.`;

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: data.title,
    description: data.summary,
    image: [new URL(`/assets/og/${data.slug}.jpg`, Astro.site).href, new URL(data.heroImage, Astro.site).href],
    datePublished: data.publishedAt.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
    inLanguage: 'en',
    mainEntityOfPage: url,
    author: { '@type': 'Person', '@id': FOUNDER_ID, name: data.author, url: new URL('/about', Astro.site).href },
    publisher: { '@id': ORG_ID },
    about: { '@id': `${url}#trip` },
  },
  {
    '@type': 'TouristTrip',
    '@id': `${url}#trip`,
    name: data.title,
    description: inShort,
    touristType: data.activities.map((a) => ACTIVITY_LABELS[a]),
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: data.stops.length,
      itemListElement: data.stops.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': s.type === 'city' ? 'City' : 'TouristAttraction',
          name: s.name,
          geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng },
        },
      })),
    },
  },
  breadcrumbs(['Travel routes', '/routes'], [data.title, `/routes/${data.slug}`]),
];
---
<Base title={`${data.title} — Xplore Routes`} description={data.summary} ogImage={`/assets/og/${data.slug}.jpg`} ogImageAlt={data.heroAlt} ogType="article" schema={schema}>
  <section class="hero">
    <img src={data.heroImage} alt={data.heroAlt} width="900" height="1350" fetchpriority="high">
    <div class="scrim"></div>
    <div class="wrap">
      <a href="/routes" class="back">← All travel routes</a>
      <div class="tags">
        <span class="tag">{data.region}</span>
        {data.activities.map((a) => <span class="tag">{ACTIVITY_LABELS[a]}</span>)}
        {data.inApp && <span class="tag app">{IN_APP_LABELS[data.inApp]}</span>}
      </div>
      <h1 class="display">{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <span class="small muted">By {data.author} · <time datetime={data.publishedAt.toISOString().slice(0, 10)}>{published}</time></span>
    </div>
  </section>

  <section class="glance-section">
    <div class="wrap">
      <div class="panel glance">
        <div><div class="micro">Duration</div><div class="h3">{data.durationDays} days · {data.nights} nights</div></div>
        <div><div class="micro">Stops</div><div class="h3">{data.stops.length} stops</div></div>
        <div><div class="micro">Best time</div><div class="h3">{monthRanges(data.bestMonths)}</div></div>
        <div><div class="micro">Cards to collect</div><div class="h3">{data.stops.length}</div></div>
        <div class="when"><MonthStrip best={data.bestMonths} okay={data.okayMonths} /></div>
      </div>
      <RouteMap stops={data.stops} />
    </div>
  </section>

  <div class="wrap">
    <article class="prose">
      <p class="in-short"><strong>In short:</strong> {inShort}</p>
      {segments.map((segment) => {
        if (segment.kind === 'html') return <Fragment set:html={segment.html} />;
        const stop = data.stops[segment.index];
        return (
          <section class="stop" id={`stop-${segment.index + 1}`}>
            <XCard name={stop.name} image={stop.image} type={stop.type} rarity={stop.rarity} />
            <div class="stop-body">
              <Fragment set:html={segment.html} />
            </div>
          </section>
        );
      })}
    </article>
  </div>

  <section class="section alt">
    <div class="wrap collect">
      <span class="eyebrow">Collect this route</span>
      <h2 class="h2">{data.stops.length} cards to collect <span class="teal">on this route</span></h2>
      <div class="cards" tabindex="0" role="region" aria-label="Cards on this route">
        {data.stops.map((s) => <XCard name={s.name} image={s.image} type={s.type} rarity={s.rarity} />)}
      </div>
      {data.collectNote && <p class="muted note-line">{data.collectNote}</p>}
      <p class="status">{data.inApp === 'available' ? 'Open in Xplore' : 'Coming to the Xplore trip planner'}</p>
      <StoreBadges />
    </div>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="wrap" style="display: flex; flex-direction: column; gap: 32px;">
        <h2 class="h2" style="font-size: 32px;">More routes</h2>
        <div class="g2" style="gap: 24px;">
          {related.map((r) => <RouteCard route={r} />)}
        </div>
      </div>
    </section>
  )}

  <DownloadBand />
</Base>

<style>
  .hero { position: relative; min-height: 600px; display: flex; align-items: flex-end; overflow: hidden; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,17,23,.2) 0%, rgba(15,17,23,.35) 45%, var(--xp-bg) 100%); }
  .hero .wrap { position: relative; padding-bottom: 64px; display: flex; flex-direction: column; gap: 18px; }
  /* Readable on any photo. */
  .back { align-self: flex-start; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: #fff; background: rgba(15,17,23,.6); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .back:hover { color: #fff; border-color: var(--xp-tint); }
  .hero .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .hero h1 { max-width: 900px; }
  .hero .lead { max-width: 680px; color: #CBD5E1; }
  .glance-section .wrap { padding-top: 56px; display: flex; flex-direction: column; gap: 24px; }
  .glance { padding: 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .glance .h3 { margin-top: 4px; }
  .glance .when { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 10px; padding-top: 20px; border-top: 1px solid var(--xp-border); }
  .stop { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 32px; align-items: start; margin: 40px 0; scroll-margin-top: 88px; }
  .stop :global(.xcard) { width: 180px; }
  .stop-body { display: flex; flex-direction: column; gap: 10px; }
  .stop-body :global(h3) { margin: 0 !important; }
  .stop-body :global(p) { margin: 0 !important; }
  .prose :global(.tip) { margin-top: 6px; padding: 12px 16px; border-radius: 12px; background: var(--xp-tint-wash); border: 1px solid rgba(20,184,166,.3); font-size: 16px; color: #E2E8F0; }
  .prose :global(.tip strong) { color: var(--xp-tint); }
  /* Wide enough for card + text in the stops; plain paragraphs keep a readable line length. */
  .prose > :global(p), .prose > :global(ul), .prose > :global(h2) { max-width: 68ch; }
  .prose { max-width: 860px; padding-top: 48px; padding-bottom: 96px; font-size: 18px; line-height: 1.7; color: #CBD5E1; }
  .prose :global(h2) { font-size: 32px; line-height: 1.15; font-weight: 700; letter-spacing: -.02em; color: var(--xp-text); margin: 56px 0 16px; }
  .prose :global(h3) { font-size: 24px; font-weight: 600; color: var(--xp-text); margin: 40px 0 10px; }
  .prose :global(p), .prose :global(ul) { margin: 0 0 16px; }
  .prose :global(strong) { color: var(--xp-text); }
  .collect { display: flex; flex-direction: column; gap: 20px; }
  /* Fixed-width cards: seven fit one desktop row, and short routes don't stretch them. */
  .collect .cards { display: flex; flex-wrap: wrap; gap: 16px; padding: 12px 0 8px; }
  .collect .cards :global(.xcard) { width: 144px; }
  .note-line { max-width: 68ch; }
  .prose .in-short { max-width: 68ch; padding: 16px 20px; border-left: 3px solid var(--xp-tint); background: var(--xp-surface); border-radius: 0 12px 12px 0; }
  .status { font-weight: 600; color: var(--xp-accent); }
  @media (max-width: 900px) { .glance { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .hero { min-height: 520px; }
    .glance { padding: 20px; }
    .stop { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .stop :global(.xcard) { width: 150px; }
    /* Phones: one swipeable row instead of a tall grid. */
    .collect .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -16px; padding: 12px 16px 20px; scrollbar-width: none; }
    .collect .cards :global(.xcard) { width: 150px; scroll-snap-align: start; }
  }
</style>
