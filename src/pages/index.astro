---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import XCard from '../components/XCard.astro';
import RouteCard from '../components/RouteCard.astro';
import DownloadBand from '../components/DownloadBand.astro';
import PhotoMatchCard from '../components/PhotoMatchCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { APP_STORE_URL, INSTAGRAM_HANDLE, INSTAGRAM_URL, TRAILER_YOUTUBE_ID } from '../consts';
import { sortByDate } from '../lib/routes';
import { APP } from '../lib/schema';
import { aggregateRating, appStoreReviews, storeRatings } from '../lib/rating';
import translations from '../data/review-translations.json';

const latest = sortByDate(await getCollection('routes')).slice(0, 3);

// Ratings and reviews come from the stores at build time; each store's appears only once it has some.
// They go into the structured data only together with the visible versions below (Google requires both).
const ratings = await storeRatings();
const { _comment, ...reviewTranslations } = translations;
const reviews = await appStoreReviews(reviewTranslations);
const REVIEWS_SHOWN = 6;
const LANGUAGE_NAMES: Record<string, string> = { de: 'German' };
const app = {
  ...APP,
  ...(ratings.length > 0 && { aggregateRating: aggregateRating(ratings) }),
  ...(reviews.length > 0 && {
    review: reviews.map((r) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: 'App Store user' },
      datePublished: r.date.toISOString().slice(0, 10),
      name: r.title,
      reviewBody: r.body,
      inLanguage: r.lang ?? 'en',
      reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 },
      publisher: { '@type': 'Organization', name: 'App Store' },
    })),
  }),
};

// Copy: the brief's 03-content/home.md.
const STEPS = [
  { title: 'Swipe', text: "Swipe through 900+ places. Right if you've been there, up if it's a dream trip, left for not yet.", img: 'ios-01-discover-swipe', alt: 'Store screenshot: Swipe your next dream trip' },
  { title: 'Collect', text: "Every place you've been becomes a card, from Common to Epic. Earn points, medals and explorer levels.", img: 'ios-02-collect-rarity', alt: 'Store screenshot: Collect adventures, not just countries' },
  { title: 'Plan', text: 'Xplore matches your wishlist to the best time to visit each place, then helps you plan the trip day by day.', img: 'ios-05-best-time', alt: 'Store screenshot: Know the best time to go' },
];

// Two "undiscovered" cards suggest the hunt. The last four are hidden on phones.
const WALL = [
  { name: 'Japan', type: 'country', rarity: 'Common', image: 'japan' },
  { name: 'Machu Picchu', type: 'landmark', rarity: 'Uncommon', image: 'machu-picchu' },
  { name: 'Fiji', type: 'country', rarity: 'Rare', image: 'fiji' },
  { name: 'Polar Bear', type: 'wildlife', rarity: 'Epic', image: 'polar-bear' },
  { name: 'Mount Everest', type: 'landmark', rarity: 'Rare', image: 'mount-everest', undiscovered: true },
  { name: 'Kyoto', type: 'city', rarity: 'Common', image: 'kyoto' },
  { name: 'Kilauea', type: 'landmark', rarity: 'Uncommon', image: 'kilauea' },
  { name: 'Santorini', type: 'island', rarity: 'Common', image: 'santorini' },
  { name: 'Petra', type: 'landmark', rarity: 'Uncommon', image: 'petra', undiscovered: true },
  { name: 'Whale Shark', type: 'wildlife', rarity: 'Epic', image: 'whale-shark' },
] as const;

const STATS = [
  { n: '900+', label: 'curated cards' },
  { n: '44', label: 'themed collections' },
  { n: '199', label: 'countries, free forever' },
  { n: '7', label: 'travel activities' },
];

const HIGHLIGHTS = [
  { title: 'Your travel map', text: 'Every claimed place lands on your world map. Every pin a memory, every blank space a reason to go.', href: '/features#map', icon: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>' },
  { title: 'Best time to go', text: 'A seasonal calendar for your whole wishlist: see which places are at their best each month.', href: '/features#plan', icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  { title: 'Trip planner', text: 'Pick a start, get stops nearby, and build your itinerary day by day, together with friends.', href: '/features#trips', icon: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5"/>' },
  { title: 'Photo scan', text: 'Pick photos from past trips and Xplore finds the places in them.', href: '/features#photos', icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>' },
  { title: 'Journey & year in review', text: 'Your trips as one flight path, and your year as a story video for Reels and TikTok.', href: '/features#relive', icon: '<path d="M3 17c3-1 5-6 9-6s6 5 9 6"/><path d="M12 11V4M9 7l3-3 3 3"/>' },
  { title: 'Medals & friends', text: 'Complete collections for Bronze to Platinum medals and compare maps with friends.', href: '/features#collect', icon: '<circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 7 5-3 5 3-1.5-7"/>' },
];

---
<Base
  title="Xplore — Travel Map, Tracker & Trip Planner App"
  description="Track the countries you've visited, collect 900+ places as cards and plan trips for the best time of year. Free travel map app for iPhone and Android."
  schema={[app]}
>
  <!-- 1 Hero -->
  <section class="hero mapbg" style="background-image: url(/assets/images/world-map.jpg);">
    <div class="wrap g2">
      <div class="copy">
        <span class="eyebrow">Travel map · Journal · Trip planner</span>
        <h1 class="display">Collect the world,<br><span class="teal">one card at a time.</span></h1>
        <p class="lead">Xplore turns every trip into a collectible card. Track the countries you've visited, watch your world map fill in, and plan your next adventure for the perfect time of year.</p>
        <StoreBadges />
        <p class="small muted">Free · No sign-up needed · iPhone &amp; Android</p>
        {ratings.length > 0 && (
          <div class="ratings">
            {ratings.map((r) => (
              <a class="rating small" href={r.url}>
                <span class="stars" aria-hidden="true">{'★'.repeat(Math.round(r.value))}<span class="off">{'★'.repeat(5 - Math.round(r.value))}</span></span>
                <span>{r.value.toFixed(1)} from {r.count} ratings on {r.store === 'App Store' ? 'the App Store' : 'Google Play'}</span>
              </a>
            ))}
          </div>
        )}
      </div>
      {/* Hero fan (brief: home.md › Hero): cards fanned behind the tilted phone, the Epic card in front. */}
      <div class="visual hide-m">
        <XCard name="Kyoto" image="/assets/cards/kyoto.webp" type="city" rarity="Common" eager style="left: -36px; top: 40px; width: 160px; transform: rotate(-14deg);" />
        <XCard name="Kilauea" image="/assets/cards/kilauea.webp" type="landmark" rarity="Uncommon" eager style="left: -12px; top: 330px; width: 160px; transform: rotate(-6deg);" />
        <XCard name="Machu Picchu" image="/assets/cards/machu-picchu.webp" type="landmark" rarity="Uncommon" eager style="right: -56px; top: 30px; width: 160px; transform: rotate(13deg);" />
        <div class="phone"><img src="/assets/screenshots/app-card-detail-fiji.webp" alt="Xplore card detail screen for Fiji" width="600" height="1305"></div>
        <XCard name="Polar Bear" image="/assets/cards/polar-bear.webp" type="wildlife" rarity="Epic" eager class="front" style="right: -40px; top: 330px; width: 190px; transform: rotate(9deg);" />
      </div>
    </div>
  </section>

  <!-- 2 How it works -->
  <section class="section">
    <div class="wrap stack">
      <div class="head">
        <span class="eyebrow">How it works</span>
        <h2 class="h2">Your travels, turned into <span class="teal">a collection</span></h2>
      </div>
      <div class="g3 steps" tabindex="0" role="region" aria-label="How it works, three steps">
        {STEPS.map((step, i) => (
          <div class="step">
            <div class="poster"><img src={`/assets/store/${step.img}.webp`} alt={step.alt} width="600" height="1301" loading="lazy"></div>
            <span class="eyebrow"><span class="num">{i + 1}</span>{step.title}</span>
            <p class="muted">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 Card wall -->
  <section class="section alt" style="overflow: hidden;">
    <div class="wrap stack" style="gap: 48px;">
      <div class="head-row">
        <div class="head">
          <span class="eyebrow">The collection</span>
          <h2 class="h2">900+ places waiting <span class="teal">to be collected</span></h2>
          <p class="muted">Countries, cities, islands, landmarks, wildlife and world wonders. Every card is hand-researched with facts and the best months to go. New cards arrive in free updates.</p>
        </div>
        <div class="rarities" aria-label="Card rarities">
          <span class="pill p-common"><span class="dot"></span>Common</span>
          <span class="pill p-uncommon"><span class="dot"></span>Uncommon</span>
          <span class="pill p-rare"><span class="dot"></span>Rare</span>
          <span class="pill p-epic"><span class="dot"></span>Epic</span>
        </div>
      </div>
      <div class="wall">
        {WALL.map((c, i) => (
          <XCard name={c.name} image={`/assets/cards/${c.image}.webp`} type={c.type} rarity={c.rarity} undiscovered={'undiscovered' in c && c.undiscovered} class={i >= 6 ? 'hide-m' : undefined} />
        ))}
      </div>
      <div class="g4">
        {STATS.map((s) => (
          <div class="panel stat"><div class="n">{s.n}</div><div class="muted small" style="margin-top: 8px;">{s.label}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Feature highlights -->
  <section class="section">
    <div class="wrap stack" style="gap: 48px;">
      <div class="head">
        <span class="eyebrow">What's inside</span>
        <h2 class="h2">Everything a traveller collects, <span class="teal">in one app</span></h2>
      </div>
      <div class="g3">
        {HIGHLIGHTS.map((h) => (
          <a class="panel highlight" href={h.href}>
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={h.icon} /></span>
            <span class="h3">{h.title}</span>
            <span class="muted small">{h.text}</span>
            <span class="more" aria-hidden="true">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 Privacy callout -->
  <section class="section alt">
    <div class="wrap g2">
      <div class="center rev-m"><PhotoMatchCard width={260} /></div>
      <div class="head" style="gap: 20px;">
        <span class="eyebrow">Private by design</span>
        <h2 class="h2">Your photos never <span class="teal">leave your phone</span></h2>
        <p class="lead">Photo scan reads only the location and date of the photos you pick, on your device. Only the matched place is saved. No ads, no tracking, no third-party analytics.</p>
        <a href="/privacy/app" class="link">How we handle your data →</a>
      </div>
    </div>
  </section>

  <!-- 6 Latest travel routes -->
  <section class="section">
    <div class="wrap stack" style="gap: 48px;">
      <div class="head-row">
        <div class="head">
          <span class="eyebrow">Travel routes</span>
          <h2 class="h2">Routes worth <span class="teal">collecting</span></h2>
          <p class="muted">Hand-picked itineraries with the best time to go. Soon you can load them straight into your trip planner.</p>
        </div>
        <a class="btn btn-secondary" href="/routes">All routes</a>
      </div>
      <div class="g3">{latest.map((r) => <RouteCard route={r} />)}</div>
    </div>
  </section>

  <!-- 6b Reviews -->
  {reviews.length > 0 && (
    <section id="reviews" class="section alt">
      <div class="wrap stack" style="gap: 48px;">
        <div class="head-row">
          <div class="head">
            <span class="eyebrow">Reviews</span>
            <h2 class="h2">What travellers <span class="teal">say about Xplore</span></h2>
            {ratings.length > 0 && <p class="muted">{ratings.map((r) => `${r.value.toFixed(1)} out of 5 from ${r.count} ratings on ${r.store === 'App Store' ? 'the App Store' : 'Google Play'}`).join(' · ')}. Every written review, newest first.</p>}
          </div>
          <a class="btn btn-secondary" href={APP_STORE_URL}>Rate Xplore</a>
        </div>
        <div class="g3 reviews">
          {reviews.slice(0, REVIEWS_SHOWN).map((r) => <ReviewCard review={r} languageName={r.lang && LANGUAGE_NAMES[r.lang]} />)}
        </div>
        {reviews.length > REVIEWS_SHOWN && (
          <details class="more-reviews">
            <summary class="btn btn-secondary">Show all {reviews.length} reviews</summary>
            <div class="g3 reviews">
              {reviews.slice(REVIEWS_SHOWN).map((r) => <ReviewCard review={r} languageName={r.lang && LANGUAGE_NAMES[r.lang]} />)}
            </div>
          </details>
        )}
      </div>
    </section>
  )}

  <!-- 7 Pricing strip -->
  <section class="pricing">
    <div class="wrap">
      <div class="panel strip">
        <div class="head" style="gap: 10px; flex: 1 1 480px;">
          <h2 class="h3" style="font-size: 26px;">Free to play. <span class="sand">No subscription.</span></h2>
          <p class="muted">All 199 countries are free forever. Want more? Unlock Cities, Islands &amp; Regions or Wildlife for $0.99 each, or the Explorer bundle with landmarks and world wonders for $1.99. Pay once and keep it.</p>
        </div>
        <a class="btn btn-secondary" href="/features#unlock">See all bundles</a>
      </div>
    </div>
  </section>

  <!-- 8 Trailer + Instagram -->
  <section class="section">
    <div class="wrap g2">
      <div class="head" style="gap: 20px;">
        <span class="eyebrow">Watch</span>
        <h2 class="h2">See Xplore <span class="teal">in 30 seconds</span></h2>
        <p class="muted">Swipe, collect, plan, relive. And follow us on Instagram for daily travel inspiration and country quizzes.</p>
        <a class="btn btn-secondary insta" href={INSTAGRAM_URL}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>@{INSTAGRAM_HANDLE}</a>
      </div>
      {/* Click-to-load facade: nothing is requested from YouTube until the visitor clicks (privacy-website.md § 5). */}
      <div class="trailer-wrap">
        <div class="trailer" data-video={TRAILER_YOUTUBE_ID}>
          <button type="button" aria-label="Play the Xplore trailer (loads YouTube)">
            <img src="/assets/store/play-trailer-thumb.jpg" alt="" width="1280" height="720" loading="lazy">
            <span class="play"><svg width="30" height="30" viewBox="0 0 24 24" fill="#0F1117" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
          </button>
        </div>
        <span class="small consent">Plays from YouTube. By clicking, you load content from YouTube (Google).</span>
      </div>
    </div>
  </section>

  <DownloadBand />
</Base>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.trailer')) {
    box.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0`;
      iframe.title = 'Xplore trailer';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  }
</script>

<style>
  .ratings { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .reviews { gap: 24px; }
  .more-reviews[open] { margin-top: -24px; }
  .more-reviews summary { list-style: none; cursor: pointer; width: fit-content; }
  .more-reviews summary::-webkit-details-marker { display: none; }
  .more-reviews[open] summary { display: none; }
  .more-reviews .reviews { margin-top: 0; }
  .rating { display: inline-flex; align-items: center; gap: 8px; color: var(--xp-text-secondary); align-self: flex-start; }
  .rating:hover { color: var(--xp-text); }
  .rating .stars { color: var(--xp-accent); letter-spacing: 2px; }
  .rating .stars .off { color: var(--xp-border); }
  .hero { padding: 96px 0 112px; }
  .hero .g2 { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .hero h1 { font-size: clamp(2.75rem, 5vw, 4rem); }
  .copy { display: flex; flex-direction: column; gap: 24px; }
  .visual { position: relative; display: flex; justify-content: center; min-height: 640px; }
  .visual .phone { position: relative; z-index: 1; width: 270px; transform: rotate(-6deg); }
  .visual :global(.xcard) { position: absolute; }
  .visual :global(.xcard.front) { z-index: 2; }

  .stack { display: flex; flex-direction: column; gap: 56px; }
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; }
  .center { display: flex; justify-content: center; }
  .link { font-weight: 600; }

  .steps { align-items: start; }
  .step { display: flex; flex-direction: column; gap: 20px; }

  .rarities { display: flex; flex-wrap: wrap; gap: 8px; }
  .wall { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
  .wall :global(.xcard) { width: 200px; }

  .highlight { padding: 28px; display: flex; flex-direction: column; gap: 14px; color: var(--xp-text); transition: border-color var(--xp-dur), transform var(--xp-dur) var(--xp-ease); }
  .highlight:hover { color: var(--xp-text); border-color: var(--xp-tint); transform: translateY(-2px); }
  .highlight .more { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--xp-tint); }

  .pricing { padding: 0 0 24px; }
  .strip { padding: 40px 48px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }

  .insta { align-self: flex-start; }
  .trailer-wrap { display: flex; flex-direction: column; gap: 10px; }
  .trailer { position: relative; aspect-ratio: 16 / 9; border-radius: 24px; overflow: hidden; border: 1px solid var(--xp-border); background: #000; }
  .trailer button { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .trailer button img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .85; transition: opacity var(--xp-dur); }
  .trailer button:hover img { opacity: 1; }
  .trailer button:focus-visible { outline: 3px solid var(--xp-tint); outline-offset: -3px; }
  .trailer .play { position: absolute; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%; background: var(--xp-tint); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 30px rgba(0,0,0,.4); }
  .trailer :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .consent { color: var(--xp-text-muted); }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 72px; }
    .hero .g2 { grid-template-columns: minmax(0, 1fr); }
    .hero h1 { font-size: 2.25rem; }
    .stack { gap: 40px; }
    /* Steps become a swipeable row of posters. */
    .steps { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; gap: 16px; margin: 0 -16px; padding: 0 16px 8px; scrollbar-width: none; }
    .step { flex: 0 0 72%; scroll-snap-align: start; }
    .wall { gap: 12px; }
    .wall :global(.xcard) { width: calc(50% - 6px); }
    .g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Compact rows: icon beside the text. */
    .highlight { padding: 18px; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 14px; row-gap: 4px; }
    .highlight .ico { grid-row: span 3; }
    .highlight .h3 { font-size: 18px; }
    .highlight .more { display: none; }
    .g3:has(> .highlight) { gap: 12px; }
    .strip { padding: 28px 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .highlight, .highlight:hover { transition: none; transform: none; }
  }
</style>
