---
import { getEntry } from 'astro:content';
import LegalPage from '../../layouts/LegalPage.astro';

const entry = (await getEntry('legal', 'privacy-website'))!;
---
{/* Hidden from search engines until the text has been legally reviewed (brief: open item 5). */}
<LegalPage entry={entry} back={{ href: '/privacy', label: 'Privacy' }} noindex>
  <Fragment slot="heading">Privacy policy: <span class="teal">this website</span></Fragment>
</LegalPage>
