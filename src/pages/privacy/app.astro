---
import { getEntry } from 'astro:content';
import LegalPage from '../../layouts/LegalPage.astro';

const entry = (await getEntry('legal', 'privacy-app'))!;
---
{/* Hidden from search engines until the text has been legally reviewed (brief: open item 2). */}
<LegalPage entry={entry} back={{ href: '/privacy', label: 'Privacy' }} noindex>
  <Fragment slot="heading">Privacy statement: <span class="teal">Xplore app</span></Fragment>
</LegalPage>
