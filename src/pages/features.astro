---
import Base from '../layouts/Base.astro';
import DownloadBand from '../components/DownloadBand.astro';
import PhotoMatchCard from '../components/PhotoMatchCard.astro';
import { CONTACT_EMAIL } from '../consts';
import { MONTHS } from '../lib/routes';
import { breadcrumbs } from '../lib/schema';

// Copy: the brief's 03-content/features.md. Layout: the design canvas's Features artboard.
const MOVES = [
  { id: 'swipe', label: 'Swipe' },
  { id: 'save', label: 'Save' },
  { id: 'photos', label: 'Photos' },
  { id: 'plan', label: 'Plan' },
  { id: 'relive', label: 'Relive' },
  { id: 'collect', label: 'Collect' },
  { id: 'unlock', label: 'Unlock' },
];

const BUNDLES = [
  { name: 'Countries', inside: 'Every nation on Earth, 199 cards', price: null },
  { name: 'Cities', inside: 'Iconic cities worldwide', price: '$0.99' },
  { name: 'Islands & Regions', inside: 'Paradise islands, remote regions and hidden gems', price: '$0.99' },
  { name: 'Wildlife', inside: 'Rare animals from all seven continents', price: '$0.99' },
  { name: 'Explorer', inside: 'Landmarks, natural wonders, historic sites and world events', price: '$1.99' },
];

const MEDALS = [
  { name: 'Bronze', pct: 20, dot: '#CD7F32', fg: '#E3A877', bg: 'rgba(180,120,70,.18)' },
  { name: 'Silver', pct: 40, dot: '#CBD5E1', fg: '#CBD5E1', bg: 'rgba(203,213,225,.15)' },
  { name: 'Gold', pct: 60, dot: '#FCD34D', fg: '#FCD34D', bg: 'rgba(252,211,77,.15)' },
  { name: 'Platinum', pct: 100, dot: '#A5F3FC', fg: '#A5F3FC', bg: 'rgba(165,243,252,.14)' },
];

const LEVELS = ['Newcomer', 'Wanderer', 'Pathfinder', 'Explorer', 'Voyager', 'Globetrotter', 'Pioneer', 'Trailblazer', 'Cartographer', 'World Walker', 'Grand Explorer'];

const ALSO = [
  { title: 'Search by activity', text: 'Find 80+ dive spots, the best surf breaks or ski regions, and combine with "best month" to match the activity\'s own season.', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>' },
  { title: 'Card stories', text: 'Tap any card for facts, the best time to go per activity and day-trip ideas nearby.', icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>' },
  { title: 'Friends & leaderboards', text: "Add friends by code, see who's been to the most countries, and compare your maps country by country.", icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/>' },
  { title: 'Share anything', text: 'Cards, your explorer card, trips and your year, each with a beautiful preview image.', icon: '<path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="m16 6-4-4-4 4M12 2v13"/>' },
  { title: 'Best next month', text: 'The home screen tells you how many places are at their best next month.', icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>' },
  { title: 'Multiple visits', text: 'Been to Paris three times? Track every visit and see them all on your timeline.', icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>' },
];

// Answers are HTML so links can be inlined; the JSON-LD gets the plain-text version.
const FAQ = [
  { q: 'Is Xplore free?', a: 'Yes. Xplore is free to download and play, and all 199 country cards are free forever. Extra bundles (Cities, Islands &amp; Regions, Wildlife, Explorer) are optional one-time purchases.' },
  { q: 'Is there a subscription?', a: 'No. Bundles are paid once and stay yours, including future cards added to them.' },
  { q: 'Do I need an account?', a: 'No, you can start swiping as a guest. A free account keeps your collection safe across phones and unlocks photo scan, trip planning and friends.' },
  { q: 'What happens to my photos?', a: 'Nothing leaves your phone. Xplore reads the location and date of the photos you pick on your device and only saves the matched place. See the <a href="/privacy/app">app privacy statement</a>.' },
  { q: 'Which devices are supported?', a: 'iPhone (iOS 15.1 or later) and Android phones.' },
  { q: 'Which languages?', a: 'Xplore is currently available in English.' },
  { q: 'How do I suggest a place?', a: `Send us your idea through the feedback form in the app (Profile › Support us) or by email to <a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a>.` },
  { q: 'How do I delete my account?', a: 'In the app: Profile › Settings › Delete account. This removes your account and all associated data.' },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&') },
  })),
};

const KYOTO = { best: ['Mar', 'Apr', 'May', 'Oct', 'Nov'], okay: ['Jun', 'Sep', 'Dec'] };
---
<Base
  title="Features — Xplore travel map, journal & trip planner"
  description="Swipe 900+ places, collect them as cards, see the best time to go, plan trips day by day, scan your photos for places you've been and relive your year as a story video."
  schema={[faqLd, breadcrumbs(['Features', '/features'])]}
>
  <section class="hero mapbg" style="background-image: url(/assets/images/world-map.jpg);">
    <div class="wrap">
      <span class="eyebrow">Features</span>
      <h1 class="h1">Seven moves to <span class="teal">collect the world</span></h1>
      <p class="lead">Xplore is part travel tracker, part trip planner, part game. Here's everything it does, in the order you'll discover it.</p>
      <div class="hero-posters">
        <div class="poster side left hide-m"><img src="/assets/store/ios-03-collections.webp" alt="Store screenshot: Complete iconic collections" width="600" height="1301"></div>
        <div class="poster front"><img src="/assets/store/ios-01-discover-swipe.webp" alt="Store screenshot: Swipe your next dream trip" width="600" height="1301"></div>
        <div class="poster side right hide-m"><img src="/assets/store/ios-05-best-time.webp" alt="Store screenshot: Know the best time to go" width="600" height="1301"></div>
      </div>
    </div>
  </section>

  <nav class="moves" aria-label="Feature sections">
    <div class="wrap">
      {MOVES.map((m) => <a class="chip" href={`#${m.id}`}>{m.label}</a>)}
    </div>
  </nav>

  <!-- 1 Swipe -->
  <section id="swipe" class="section">
    <div class="wrap g2">
      <div class="text">
        <span class="eyebrow"><span class="num">1</span>Discover</span>
        <h2 class="h2">Swipe your next <span class="teal">dream trip</span></h2>
        <p class="muted">One card at a time, the whole planet. Swipe right if you've been there, up if it's a dream trip, left if it's not your thing yet. Two decks to explore: Places and Wildlife, filtered by countries, landmarks, islands, cities or events.</p>
        <ul class="checks">
          <li>900+ hand-researched places and animals</li>
          <li>Every claim earns points: Common 1, Uncommon 2, Rare 3, Epic 4</li>
          <li>Bigger celebrations for rarer finds</li>
        </ul>
      </div>
      <div class="pair">
        <div class="poster"><img src="/assets/store/ios-02-collect-rarity.webp" alt="Store screenshot: Collect adventures, not just countries" width="600" height="1301" loading="lazy"></div>
        <div class="poster"><img src="/assets/store/ios-01-discover-swipe.webp" alt="Store screenshot: Swipe your next dream trip" width="600" height="1301" loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- 2 Save -->
  <section id="save" class="section alt">
    <div class="wrap g2">
      <div class="rev-m center">
        <div class="phone"><img src="/assets/screenshots/app-moves-swipe-the-world.webp" alt="Xplore in 7 moves: Swipe the world" width="600" height="1305" loading="lazy"></div>
      </div>
      <div class="text">
        <span class="eyebrow"><span class="num">2</span>No sign-up needed</span>
        <h2 class="h2">Start in seconds. <span class="teal">Keep it forever.</span></h2>
        <p class="muted">Open the app and start swiping, with no account required. When you're ready, a free account keeps your collection safe on every phone, and everything you collected as a guest comes with you.</p>
      </div>
    </div>
  </section>

  <!-- 3 Photos -->
  <section id="photos" class="section">
    <div class="wrap g2">
      <div class="text">
        <span class="eyebrow"><span class="num">3</span>Photo scan</span>
        <h2 class="h2">Find your travel memories <span class="teal">in your photos</span></h2>
        <p class="muted">Pick photos from past trips and Xplore matches their location to the countries and landmarks you've been to, then claims them for you. Clear matches are added automatically; you confirm the rest.</p>
        <div class="note privacy">
          <span class="ico" style="background: transparent;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
          <p class="small"><strong>Your photos stay on your device.</strong> Xplore reads only the location and date of the photos you pick; only the matched place is saved to your account. You can forget all photo data in Settings at any time.</p>
        </div>
      </div>
      <div class="center">
        <PhotoMatchCard />
      </div>
    </div>
  </section>

  <!-- 4 Plan -->
  <section id="plan" class="section alt">
    <div class="wrap stack">
      <div class="g2">
        <div class="rev-m center">
          <div class="poster" style="width: 300px;"><img src="/assets/store/ios-05-best-time.webp" alt="Store screenshot: Know the best time to go" width="600" height="1301" loading="lazy"></div>
        </div>
        <div class="text">
          <span class="eyebrow"><span class="num">4</span>Best time &amp; trips</span>
          <h2 class="h2">Know the best <span class="teal">time to go</span></h2>
          <p class="muted">Every place in Xplore comes with its best, okay and avoid months, and many have separate seasons for diving, hiking, surfing, skiing, safari and more. Plan › Year shows which places on your wishlist are at their best each month.</p>
          <div class="months" role="img" aria-label="Example: Kyoto is best from March to May and in October and November">
            {MONTHS.map((m) => <div class={KYOTO.best.includes(m) ? 'm-best' : KYOTO.okay.includes(m) ? 'm-ok' : 'm-avoid'}>{m}</div>)}
          </div>
          <span class="small muted">Example: Kyoto. Best · Okay · Avoid</span>
        </div>
      </div>
      <div id="trips" class="g2">
        <div class="text">
          <h3 class="h2 sub">Plan trips <span class="teal">in minutes</span></h3>
          <p class="muted">Pick a start and get stops nearby. Xplore turns your stops into a day-by-day itinerary on a map, suggests day trips, and links stays on Booking.com for every night. Share the trip link and plan together with friends.</p>
          <ul class="checks">
            <li>Mix collectible cards with your own places: restaurants, hotels, viewpoints</li>
            <li>Nights per stop, dates and a route map</li>
            <li>Best-month hints for every stop</li>
            <li>Shared trips: everyone with the link plans together</li>
          </ul>
        </div>
        <div class="pair">
          <div class="poster"><img src="/assets/store/ios-06-trip-planner.webp" alt="Store screenshot: Plan trips in minutes" width="600" height="1301" loading="lazy"></div>
          <div class="phone hide-m"><img src="/assets/screenshots/app-trip-example-japan.webp" alt="Example trip: Japan's classic route, 7 stops" width="600" height="1305" loading="lazy"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Relive -->
  <section id="relive" class="section">
    <div class="wrap stack">
      <div id="map" class="g2">
        <div class="text">
          <span class="eyebrow"><span class="num">5</span>Journey</span>
          <h2 class="h2">Relive <span class="teal">every journey</span></h2>
          <p class="muted">Your travel journal builds itself: a timeline of every trip as one flight path, the kilometres you've travelled and a world map that fills in with every place you claim.</p>
        </div>
        <div class="pair">
          <div class="poster"><img src="/assets/store/play-06-journey-timeline.webp" alt="Store screenshot: Relive every journey" width="600" height="1067" loading="lazy"></div>
          <div class="poster"><img src="/assets/store/ios-04-world-map.webp" alt="Store screenshot: Your travels on one map" width="600" height="1301" loading="lazy"></div>
        </div>
      </div>
      <div class="g2">
        <div class="rev-m pair">
          <div class="phone"><img src="/assets/screenshots/app-year-in-review-cover.webp" alt="Year in review cover: one unforgettable year" width="600" height="1305" loading="lazy"></div>
          <div class="phone hide-m"><img src="/assets/screenshots/app-year-in-review-distance.webp" alt="Year in review: distance travelled" width="600" height="1305" loading="lazy"></div>
        </div>
        <div class="text">
          <h3 class="h2 sub">Your year, <span class="teal">as a story</span></h3>
          <p class="muted">At the end of the year, Xplore turns your travels into a story: distance travelled, countries, the longest trip, your rarest card. Export it as one video, ready for Instagram Reels, Stories, TikTok or WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Collect -->
  <section id="collect" class="section alt">
    <div class="wrap g2">
      <div class="rev-m pair">
        <div class="poster"><img src="/assets/store/ios-03-collections.webp" alt="Store screenshot: Complete iconic collections" width="600" height="1301" loading="lazy"></div>
        <div class="poster"><img src="/assets/store/play-08-profile-stats.webp" alt="Store screenshot: Track your progress" width="600" height="1067" loading="lazy"></div>
      </div>
      <div class="text">
        <span class="eyebrow"><span class="num">6</span>Collections</span>
        <h2 class="h2">Complete <span class="teal">iconic collections</span></h2>
        <p class="muted">44 themed collections: the Seven Wonders, volcanoes, top diving spots, safari wildlife, every region of the world. Reach 20, 40, 60 and 100 % of a collection for Bronze, Silver, Gold and Platinum medals, and climb eleven explorer levels from Newcomer to Grand Explorer.</p>
        <div class="medals">
          {MEDALS.map((m) => (
            <span class="pill" style={`background: ${m.bg}; color: ${m.fg};`}><span class="dot" style={`background: ${m.dot};`}></span>{m.name} {m.pct} %</span>
          ))}
        </div>
        <p class="small levels">{LEVELS.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- 7 Unlock -->
  <section id="unlock" class="section">
    <div class="wrap g2" style="align-items: start;">
      <div class="text">
        <span class="eyebrow"><span class="num">7</span>Bundles</span>
        <h2 class="h2">Free to play. <span class="teal">Pay once if you want more.</span></h2>
        <p class="muted">All countries are free, forever. Extra bundles unlock with a one-time purchase: no subscription, and every future card in that bundle is included.</p>
        <table class="panel bundles">
          <caption class="sr-only">Bundles and prices</caption>
          <tbody>
            {BUNDLES.map((b) => (
              <tr>
                <th scope="row">{b.name}</th>
                <td class="muted small">{b.inside}</td>
                <td class="price">{b.price ?? <span class="pill p-uncommon">Free</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <span class="small levels">Prices as listed in the App Store (0,99 € / 1,99 €); may vary by country and store.</span>
      </div>
      <div class="center">
        <div class="poster hide-m" style="width: 320px;"><img src="/assets/store/play-07-overview-bundles.webp" alt="Store screenshot: 199 countries, 900+ places" width="600" height="1067" loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- Also in Xplore -->
  <section class="section alt">
    <div class="wrap stack" style="gap: 48px;">
      <div class="text" style="gap: 14px;">
        <span class="eyebrow">Also in Xplore</span>
        <h2 class="h2">Small things travellers <span class="teal">love</span></h2>
      </div>
      <div class="g3">
        {ALSO.map((t) => (
          <div class="panel tile">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} /></span>
            <h3 class="h3">{t.title}</h3>
            <p class="muted small">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="wrap text" style="max-width: 880px; gap: 24px;">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2">Questions, <span class="teal">answered</span></h2>
      <div class="faq">
        {FAQ.map(({ q, a }, i) => (
          <details open={i === 0}>
            <summary>{q}<svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <p set:html={a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <DownloadBand />
</Base>

<script>
  // Highlight the chip of the section in view.
  const chips = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.moves a')].map((a) => [a.hash.slice(1), a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        chips.forEach((a, id) => {
          const active = id === e.target.id;
          a.classList.toggle('on', active);
          if (active) {
            a.setAttribute('aria-current', 'true');
            a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          } else {
            a.removeAttribute('aria-current');
          }
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  chips.forEach((_, id) => observer.observe(document.getElementById(id)!));
</script>

<style>
  .hero { padding: 96px 0 88px; overflow: hidden; }
  .hero .wrap { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .hero h1 { max-width: 820px; }
  .hero .lead { max-width: 640px; }
  /* Three whole posters, fanned, the middle one in front. */
  .hero-posters { display: flex; justify-content: center; align-items: center; margin-top: 40px; }
  .hero-posters .poster { flex: none; }
  .hero-posters .front { position: relative; z-index: 1; width: 240px; }
  .hero-posters .side { width: 200px; }
  .hero-posters .left { transform: translate(28px, 28px) rotate(-7deg); }
  .hero-posters .right { transform: translate(-28px, 28px) rotate(7deg); }

  /* Sticky in-page nav, sits under the 64px site header. */
  .moves { position: sticky; top: 64px; z-index: 5; background: rgba(15,17,23,.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--xp-border); }
  .moves .wrap { display: flex; gap: 8px; padding-top: 12px; padding-bottom: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; }
  .moves .wrap::-webkit-scrollbar { display: none; }
  section[id], #trips, #map { scroll-margin-top: 136px; }

  .text { display: flex; flex-direction: column; gap: 20px; }
  .center { display: flex; justify-content: center; }
  .stack { display: flex; flex-direction: column; gap: 96px; }
  .h2.sub { font-size: 34px; }
  .pair { display: flex; gap: 20px; justify-content: center; align-items: flex-start; }
  .pair > * { width: 46%; }
  .pair > :nth-child(2) { margin-top: 48px; }

  .checks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .checks li { display: flex; gap: 12px; }
  .checks li::before { content: '✓'; color: var(--xp-tint); }

  .privacy { display: flex; gap: 14px; }
  .privacy p { color: #E2E8F0; }

  .medals { display: flex; gap: 10px; flex-wrap: wrap; }
  .levels { color: var(--xp-text-muted); }

  .bundles { width: 100%; border-collapse: collapse; overflow: hidden; text-align: left; }
  .bundles th, .bundles td { padding: 18px 22px 18px 0; vertical-align: middle; }
  .bundles th { padding-left: 22px; font-weight: 600; width: 32%; }
  .bundles td.price { text-align: right; font-weight: 600; white-space: nowrap; }
  .bundles tr + tr > * { border-top: 1px solid var(--xp-border); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .tile { padding: 28px; display: flex; flex-direction: column; gap: 12px; }

  .faq a { text-decoration: underline; }
  .chev { flex: none; color: var(--xp-tint); transition: transform var(--xp-dur) var(--xp-ease); }
  details[open] .chev { transform: rotate(180deg); }

  @media (max-width: 900px) {
    .moves .wrap { justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 64px; }
    .hero-posters { margin-top: 16px; }
    .hero-posters .front { width: 220px; }
    .stack { gap: 72px; }
    .h2.sub { font-size: 28px; }
    /* Phones: one smaller image per section keeps the page short. Overrides the inline desktop widths. */
    .pair > :nth-child(2) { display: none; }
    .section .g2 .poster, .section .g2 .phone { width: 60% !important; max-width: 230px; margin-top: 0; }
    .section .g2 .xcard { width: 220px !important; }
    /* Compact rows: icon beside the text. */
    .tile { padding: 18px; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 14px; row-gap: 4px; }
    .tile .ico { grid-row: span 2; }
    .tile .h3 { font-size: 18px; }
    .g3:has(> .tile) { gap: 12px; }
    /* Description drops below the name so the price keeps its column. */
    .bundles tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding: 14px 16px; column-gap: 12px; }
    .bundles tr + tr { border-top: 1px solid var(--xp-border); }
    .bundles tr + tr > * { border-top: 0; }
    .bundles th, .bundles td { padding: 0; width: auto; }
    .bundles td.muted { grid-column: 1 / -1; grid-row: 2; margin-top: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev { transition: none; }
  }
</style>
