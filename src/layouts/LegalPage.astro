---
// Legal text page (brief: 02-design-system.md › Legal page layout): single column, "Last updated" line,
// sticky table of contents on desktop, collapsible on phones.
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'legal'>;
  back?: { href: string; label: string };
  noindex?: boolean;
}
const { entry, back, noindex = false } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const { title, description, last_updated, summary } = entry.data;
---
<Base title={title} description={description} noindex={noindex}>
  <section class="legal-page">
    <div class="wrap layout">
      <article class="legal">
        {back && <a href={back.href} class="small back">← {back.label}</a>}
        <h1 class="h1"><slot name="heading" /></h1>
        {last_updated && <p class="small updated">Last updated: {last_updated}</p>}
        {summary && (
          <div class="note">
            <p><strong>In short:</strong></p>
            <ul>{summary.map((s) => <li>{s}</li>)}</ul>
          </div>
        )}
        {toc.length > 3 && (
          <details class="toc-m show-m">
            <summary>On this page</summary>
            <nav aria-label="On this page">{toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
          </details>
        )}
        <Content />
      </article>
      {toc.length > 3 && (
        <nav class="panel toc hide-m" aria-label="On this page">
          <span class="micro">On this page</span>
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
    </div>
  </section>
</Base>

<script>
  // Highlight the section in view in the desktop table of contents.
  // The current section is the last heading above the top fifth of the viewport.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const headings = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  let frame = 0;
  const update = () => {
    frame = 0;
    const line = innerHeight * 0.2;
    let current = -1;
    headings.forEach((h, i) => {
      if (h && h.getBoundingClientRect().top <= line) current = i;
    });
    links.forEach((a, i) => a.classList.toggle('on', i === current));
  };
  if (links.length) {
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    update();
  }
</script>

<style>
  .legal-page { padding: 80px 0 112px; }
  .layout { display: flex; gap: 64px; align-items: flex-start; }
  .legal { flex: 1 1 auto; min-width: 0; }
  .back { font-weight: 600; display: inline-block; margin-bottom: 20px; }
  .legal > :global(p), .legal > :global(ul) { margin-top: 16px; }
  .updated { margin-top: 12px; color: var(--xp-text-muted); }
  .note { margin-top: 24px; }
  .note p, .note li { color: #E2E8F0; }
  .note ul { margin-top: 4px; }
  .legal :global(h2) { scroll-margin-top: 88px; }
  .legal :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .legal :global(ul ul) { margin-top: 4px; }

  .toc { position: sticky; top: 96px; flex: 0 0 280px; padding: 24px; display: flex; flex-direction: column; gap: 10px; font-size: 14px; max-height: calc(100vh - 128px); overflow-y: auto; }
  .toc a { color: #CBD5E1; }
  .toc a.on, .toc a:hover { color: var(--xp-tint); }

  .toc-m { margin-top: 24px; border: 1px solid var(--xp-border); border-radius: 16px; background: var(--xp-surface); padding: 14px 18px; flex-direction: column; }
  .toc-m summary { cursor: pointer; font-weight: 600; }
  .toc-m nav { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; font-size: 15px; }
  .toc-m nav a { color: #CBD5E1; text-decoration: none; }

  @media (max-width: 640px) {
    .legal-page { padding: 48px 0 72px; }
    .legal :global(h2) { margin-top: 40px; }
  }
</style>
